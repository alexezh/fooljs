FoolJS {
  Program = Rule | Equation | Expression

  Rule = Expression "=>" DoBlock WhereClause?  -- do
       | Expression "=>" Expression WhereClause?  -- simple

  DoBlock = "do" "[" ListOf<InnerRule, ","> "]"

  InnerRule = Expression "=>" Expression WhereClause?

  Equation = Expression "=" Expression

  WhereClause = "where" "[" ListOf<WhereExpr, ","> "]"  -- array
              | "where" ListOf<WhereExpr, ",">  -- inline

  WhereExpr
    = Expression ":=" Expression  -- bind
    | Expression

  Expression
    = AddExpr

  AddExpr
    = AddExpr "+" MulExpr  -- add
    | AddExpr minusOp MulExpr  -- sub
    | MulExpr

  MulExpr
    = MulExpr "*" ImplicitMul  -- mul
    | MulExpr "/" ImplicitMul  -- div
    | ImplicitMul

  ImplicitMul
    = number UnaryExpr  -- implicit
    | UnaryExpr

  UnaryExpr
    = minusOp UnaryExpr  -- neg
    | PowExpr

  minusOp = "-" | "–" | "—" | "−"  // Hyphen-minus (U+002D), en-dash (U+2013), em-dash (U+2014), minus sign (U+2212)

  PowExpr
    = SpreadExpr "^" PowExpr  -- pow
    | SpreadExpr

  SpreadExpr
    = Primary "..."  -- spread
    | Primary

  Primary
    = FuncCall
    | List
    | Tuple
    | "(" Expression ")"  -- paren
    | MatchRoot
    | Symbol
    | PatVar
    | number

  MatchRoot
    = "$" "[" Expression "]"  -- indexed
    | "$"  -- root

  FuncCall = CallTarget "(" ListOf<Expression, ","> ")"

  CallTarget
    = ident
    | PatVar

  List = "[" ListOf<Expression, ","> "]"

  Tuple = "(" NonemptyListOf<Expression, ","> ")"

  Symbol
    = ident "{" ListOf<Expression, ","> "}"  -- indexed
    | identPlain number                       -- numbered
    | ident                                   -- plain

  identPlain = letter (letter | "_")*

  PatVar = "?" ident number?

  ident = letter (alnum | "_")*

  number = digit+
}
