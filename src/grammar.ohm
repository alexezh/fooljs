FoolJS {
  Program = Rule | Equation | Expression

  Rule = Expression "=>" Expression WhereClause?

  Equation = Expression "=" Expression

  WhereClause = "where" ConstraintList

  ConstraintList = Constraint ("," Constraint)*

  Constraint
    = "not" Constraint               -- not
    | "eq_ast" "(" Expression "," Expression ")" -- eq_ast
    | PatVar "is" TypeName           -- type
    | Expression "=>" Expression     -- rule
    | Expression "matches" Expression -- match
    | Expression "=" Expression      -- assign

  TypeName = "number" | "var" | "symbol_name" | "func_name" | "nonzero_number" | "nonneg_number" | "positive_number"

  Expression
    = AddExpr

  AddExpr
    = AddExpr "+" MulExpr  -- add
    | AddExpr minusOp MulExpr  -- sub
    | MulExpr

  MulExpr
    = MulExpr "*" ImplicitMul  -- mul
    | MulExpr "/" ImplicitMul  -- div
    | ImplicitMul

  ImplicitMul
    = number UnaryExpr  -- implicit
    | UnaryExpr

  UnaryExpr
    = minusOp UnaryExpr  -- neg
    | PowExpr

  minusOp = "-" | "–" | "—" | "−"  // Hyphen-minus (U+002D), en-dash (U+2013), em-dash (U+2014), minus sign (U+2212)

  PowExpr
    = SpreadExpr "^" PowExpr  -- pow
    | SpreadExpr

  SpreadExpr
    = Primary "..."  -- spread
    | Primary

  Primary
    = FuncCall
    | List
    | Tuple
    | "(" Expression ")"  -- paren
    | Symbol
    | PatVar
    | number

  FuncCall = CallTarget "(" ListOf<Expression, ","> ")"

  CallTarget
    = ident
    | PatVar

  List = "[" ListOf<Expression, ","> "]"

  Tuple = "(" NonemptyListOf<Expression, ","> ")"

  Symbol
    = ident "{" ListOf<Expression, ","> "}"  -- indexed
    | identPlain number                       -- numbered
    | ident                                   -- plain

  identPlain = letter (letter | "_")*

  PatVar = "?" ident number?

  ident = letter (alnum | "_")*

  number = digit+
}
